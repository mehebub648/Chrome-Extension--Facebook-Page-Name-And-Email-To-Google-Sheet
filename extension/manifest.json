{
  "manifest_version": 3,
  "name": "Save FB Page",
  "version": "2.0.0",
  "description": "Collects { name, email, link } from the page and posts to your Apps Script endpoint. Settings are saved locally.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "save-data": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save Facebook page data to Google Sheets"
    }
  },
  "action": {
    "default_icon": {
      "512": "icons/icon512.png"
    },
    "default_title": "Save FB Page",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.ico",
    "48": "icons/icon48.ico",
    "128": "icons/icon128.ico",
    "512": "icons/icon512.png"
  }
}