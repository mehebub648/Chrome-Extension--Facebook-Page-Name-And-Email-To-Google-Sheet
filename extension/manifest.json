{
  "manifest_version": 3,
  "name": "Save FB Page",
  "version": "2.0.0",
  "description": "Collects { name, email, link } from the page and posts to your Apps Script endpoint. Settings are saved locally.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_icon": {
      "512": "icons/icon512.png"
    },
    "default_title": "Save FB Page",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.ico",
    "48": "icons/icon48.ico",
    "128": "icons/icon128.ico",
    "512": "icons/icon512.png"
  }
}